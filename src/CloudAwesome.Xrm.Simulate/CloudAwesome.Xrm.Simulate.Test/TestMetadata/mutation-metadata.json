        { "logicalName": "name", "attributeType": "String", "isValidForCreate": true, "isValidForUpdate": true, "isValidForRead": true },
        { "logicalName": "description", "attributeType": "Memo", "isValidForCreate": true, "isValidForUpdate": true, "isValidForRead": true },
        { "logicalName": "accountnumber", "attributeType": "String", "maxLength": 20, "isValidForCreate": true, "isValidForUpdate": true, "isValidForRead": true },
        { "logicalName": "code", "attributeType": "String", "isValidForCreate": true, "isValidForUpdate": true, "isValidForRead": true },
        { "logicalName": "parentid", "attributeType": "Lookup", "isValidForCreate": true, "isValidForUpdate": true, "isValidForRead": true }
      ],
      "alternateKeys": [
        { "keyName": "account_number", "attributeLogicalNames": ["accountnumber"], "keyStatus": "Active" },
        { "keyName": "account_composite", "attributeLogicalNames": ["code", "parentid"], "keyStatus": "Active" },
        { "keyName": "pending_description", "attributeLogicalNames": ["description"], "keyStatus": "Pending" }
      ]
    }
  ]
